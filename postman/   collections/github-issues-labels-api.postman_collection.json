        {
          "name": "POST create issue (readonly token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden with read-only token\", function () {\r\n    pm.response.to.have.status(403);\r\n});\r\n\r\npm.test(\"Error message indicates insufficient permissions\", () => {\r\n    const responseBody = pm.response.json();\r\n    pm.expect(responseBody.message).to.eql(\"Resource not accessible by personal access token\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{vault:github_token_readonly}}",
