      "name": "00- Smoke",
      "item": [
        {
          "name": "GET repo exists (write token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"full_name matches owner/repo\", () => {\r\n    const responseBody = pm.response.json();\r\n    const expectedFullName = `${pm.collectionVariables.get(\"owner\")}/${pm.collectionVariables.get(\"repo\")}`;\r\n    pm.expect(responseBody.full_name).to.eql(expectedFullName);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/repos/{{owner}}/{{repo}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "repos",
                "{{owner}}",
                "{{repo}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET list issues (write token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response is an array\", () => {\r\n    pm.expect(pm.response.json()).to.be.an('array');\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
