{
  "name": "GitHub Sandbox (template)",
  "_postman_variable_scope": "environment",
  "values": [
    {
      "key": "base_url",
      "value": "https://api.github.com",
      "enabled": true
    },
    {
      "key": "owner",
      "value": "YOUR_GITHUB_USERNAME",
      "enabled": true
    },
    {
      "key": "repo",
      "value": "YOUR_SANDBOX_REPO",
      "enabled": true
    }
  ]
}
